# AEGIS One Backend Configuration
PROJECT_NAME="AEGIS One Authentication & Access Control API"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS (comma separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# Firebase Admin SDK Configuration
# Absolute path to your serviceAccountKey.json downloaded from Firebase Console
# In production on GCP Cloud Run/App Engine, omit this to use Application Default Credentials (ADC)
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID="aegis-one-dev"

# Emulators (optional for local Firebase testing)
# FIRESTORE_EMULATOR_HOST="localhost:8080"
# FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Secure Administrator Bootstrap Secret
# This secret is used ONLY for initial platform bootstrap to elevate the first administrator account
ADMIN_BOOTSTRAP_SECRET="replace-with-a-cryptographically-secure-random-secret"
